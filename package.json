{
  "name": "terminal-plus",
  "version": "1.1.12",
  "private": true,
  "type": "module",
  "description": "Monitor Pi, Codex and Claude sessions on Windows and Linux, with access through Even Hub and G2.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx apps/windows/src/cli.ts",
    "terminal:codex": "tsx apps/windows/src/connectors/terminal.ts --tunnel codex",
    "terminal:claude": "tsx apps/windows/src/connectors/terminal.ts --tunnel claude",
    "pair": "tsx apps/windows/src/pairing.ts",
    "push": "tsx apps/windows/src/push-cli.ts",
    "dev": "vite --config apps/evenhub/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/evenhub/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "pack:evenhub": "npm run build:hub && node scripts/package-hub.mjs",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/windows/desktop/build.ps1",
    "desktop:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/desktop/run.ps1",
    "desktop": "powershell -NoProfile -Command \"Start-Process -FilePath ./Terminal-plus.exe -WindowStyle Hidden\"",
    "release:build": "node scripts/package-release.mjs",
    "release:linux": "node scripts/package-linux.mjs",
    "release:npm": "node scripts/package-npm.mjs",
    "build:hub": "tsc --noEmit && vite build --config apps/evenhub/vite.config.ts --mode hub --outDir dist-hub"
  },
  "dependencies": {
    "google-auth-library": "^11.1.0",
    "qr-image": "^3.2.0",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/pretext": "0.1.4",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "jsqr": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Liang-Chu/Even-G2-Terminal-plus.git"
  },
  "homepage": "https://github.com/Liang-Chu/Even-G2-Terminal-plus"
}
